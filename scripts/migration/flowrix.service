[Unit]
Description=Flowrix game server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=akuah
Group=akuah
WorkingDirectory=/opt/akuah
Environment=NODE_ENV=production
ExecStart=/usr/local/bin/node /opt/akuah/server.js --port 3000 --db /opt/akuah/inventory.json --bots 0
Restart=always
RestartSec=2
TimeoutStopSec=90
LimitNOFILE=65535
MemoryMax=6G

[Install]
WantedBy=multi-user.target
